{
  "name": "react-scroll-parallax-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build --concurrency=1",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json,js,cjs,mjs}\"",
    "typecheck": "turbo run typecheck",
    "size": "pnpm --filter react-scroll-parallax exec size-limit",
    "storybook": "turbo run dev --filter=@react-scroll-parallax/storybook",
    "build-storybook": "turbo run build --filter=@react-scroll-parallax/storybook",
    "docs": "turbo run dev --filter=@react-scroll-parallax/documentation",
    "docs:build": "turbo run build --filter=@react-scroll-parallax/documentation"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.9.12",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "always"
  },
  "pnpm": {
    "overrides": {
      "webpack": "5.93.0"
    }
  }
}
